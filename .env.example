# Names only. Never commit real values.
# Copy to apps/worker/.dev.vars for local wrangler, and set the same
# names as Cloudflare Worker secrets / GitHub Actions secrets.

# eBay application (Browse API uses client credentials)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_REDIRECT_URI=
EBAY_ENV=production
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_SCOPES=https://api.ebay.com/oauth/api_scope

# User OAuth (authorization code). Leave unset until connecting a user account.
EBAY_USER_SCOPES=https://api.ebay.com/oauth/api_scope

# Optional: UK postcode used in X-EBAY-C-ENDUSERCTX for shipping estimates
EBAY_BUYER_POSTAL_CODE=

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Worker
APP_BASE_URL=https://example.workers.dev
FRONTEND_ORIGIN=https://mrlucien-johnson.github.io
TOKEN_ENCRYPTION_KEY=
WEBHOOK_VERIFICATION_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,https://mrlucien-johnson.github.io

# Optional notification providers (not required for core)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=

# Web Push (PWA) — CONFIGURATION_REQUIRED until set
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Frontend (safe to expose — public Worker URL only, never secrets)
VITE_API_BASE_URL=
VITE_DEMO_MODE=true
